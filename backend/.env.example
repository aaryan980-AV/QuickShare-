# Server Configuration
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Expiration (in seconds, default 86400 = 24 hours)
CODE_EXPIRY_SECONDS=86400

# Vercel Blob Storage Token (required for production, get from Vercel Storage dashboard)
BLOB_READ_WRITE_TOKEN=

# Vercel KV Database (required for production, get from Vercel Storage dashboard)
KV_REST_API_URL=
KV_REST_API_TOKEN=
